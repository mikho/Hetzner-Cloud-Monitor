# Hetzner Cloud Console -> project -> Security -> API tokens (Read-only is enough)
# One read-only token per Hetzner project (Console -> project -> Security -> API tokens).
# Single project:   HCLOUD_TOKEN=...
# Several projects: HCLOUD_TOKEN_<NAME>=...  (NAME becomes the project label; use letters, digits, _)
HCLOUD_TOKEN=
# HCLOUD_TOKEN_PRODUCTION=
# HCLOUD_TOKEN_STAGING=
# HCLOUD_TOKEN_CLIENT_ACME=
# Optional HTTP basic auth (any username, this password)
DASHBOARD_PASSWORD=
# Show prices excluding VAT (default: gross, incl. VAT). Values in prices.json are used as-is.
# PRICE_BASIS=net
# Storage Boxes use a different API host. Only set this if a project's token doesn't work for them.
# HETZNER_STORAGE_TOKEN=                 (single project)
# HETZNER_STORAGE_TOKEN_PRODUCTION=      (per project, same NAME as above)
